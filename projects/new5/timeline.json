    {
      "text": "Anak aku adalah | *Raysha Sofia.*"
    },
    {
      "text": "Dia umur *2 tahun*, | dia memang *minat sangat* dekat Pikachu."
    },
    {
      "text": "Hari-hari dia akan *tidur* | dengan Pikachu."
    },
    {
      "text": "Dia akan *makan* | dengan Pikachu."
    },
    {
      "text": "Dia akan *bermain* | dengan Pikachu."
    },
    {
      "text": "Dan akan datang, | dia akan pergi *sekolah* dengan Pikachu."
    },
    {
      "text": "Pergi sekolah pula | naik *basikal* dengan Pikachu."
    },
    {
      "text": "Memang sangat *romantik.*"
    },
    {
      "text": "Anak aku *suka* | dan *sayang* dengan Pikachu."
    },
    {
      "text": "*Hari jadi* dia nanti, | dia akan *sambut* sekali dengan Pikachu."
    }
