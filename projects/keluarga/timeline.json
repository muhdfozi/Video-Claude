  "lines": [
    {
      "text": "Hari ini adalah *hari kanak-kanak.* | Hari kanak-kanak *sedunia.*",
      "captionHidden": true
    },
    {
      "text": "Hari ini, Raysha pergi | *Pusat Sains Negara.*"
    },
    {
      "text": "Dia pergi dengan *bapa*, | dan pergi dengan *ibu.*"
    },
    {
      "text": "Dia pergi naik *kereta.*"
    },
    {
      "text": "Sampai saja, Raysha *main semua*, | semua barang yang ada di Pusat Sains Negara."
    },
    {
      "text": "Dia main *playground*, | dia tengok *Didi & Friends*, | dia main *toys*,"
    },
    {
      "text": "lepas tu dia main *lari-lari*, | lepas tu dia main *lompat-lompat*, | dan macam-macam lagi."
    },
    {
      "text": "Lepas tu dia *balik*, | dia pergi beli *barang-barang dapur*,"
    },
    {
      "text": "dia pergi *shopping* | dengan ibu dan bapak."
    },
    {
      "text": "Raysha *happy*, dia tengok *banyak makanan*, | dia *pilih* makanan yang ada."
    },
    {
      "text": "Lepas itu dia *terjumpa Pikachu.*"
    },
    {
      "text": "Lepas itu dia balik dengan *Pikachu*, | *Didi & Friends.* | Balik ke *rumah.*"
    }
  ],
